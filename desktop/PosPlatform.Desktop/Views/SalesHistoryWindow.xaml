<Window x:Class="PosPlatform.Desktop.Views.SalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kunlik savdolar" Height="620" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7">
    <DockPanel Margin="14">
        <!-- Sarlavha + sana tanlovchi -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Kunlik savdolar" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="‹" Width="32" Padding="0,4" Click="PrevDay_Click" ToolTip="Oldingi kun" />
                <DatePicker x:Name="DayPicker" Width="140" Margin="6,0" SelectedDateChanged="Day_Changed" />
                <Button Content="›" Width="32" Padding="0,4" Click="NextDay_Click" ToolTip="Keyingi kun" />
                <Button Content="Yangilash" Padding="10,5" Margin="10,0,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- Kunlik jami -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E5EA" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Savdolar" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="CountText" Text="0" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Naqd" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="CashText" Text="0" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Karta" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="CardText" Text="0" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="O'tkazma" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="TransferText" Text="0" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Nasiya" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="DebtText" Text="0" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Qaytarish" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="RefundText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sof tushum" FontSize="11" Foreground="#6B7280" />
                        <TextBlock x:Name="NetText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="#E2E5EA" Margin="0,8,0,6" />

                <!-- QR (fiskal) chek bilan sotilganlar -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="QR chek:" Width="90" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                    <TextBlock Text="Naqd" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="QrCashText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Terminal" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="QrCardText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="O'tkazma" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="QrTransferText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Aralash" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="QrMixedText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- QR berilmagan (oddiy) cheklar -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Oddiy chek:" Width="90" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock Text="Naqd" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlainCashText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Terminal" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlainCardText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="O'tkazma" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlainTransferText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Aralash" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlainMixedText" Text="0" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Pastki tugmalar -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PrintButton" Content="🖨  Chekni chop etish" Height="42" Width="220"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="Print_Click" />
                <Button x:Name="RefundButton" Content="↩  Qaytarish" Height="42" Width="160" Margin="10,0,0,0"
                        Background="#FEE2E2" Foreground="#B91C1C" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="DoRefund_Click" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="SalesList" BorderBrush="#E2E5EA" MouseDoubleClick="Print_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Chek" Width="150" DisplayMemberBinding="{Binding ReceiptNumber}" />
                    <GridViewColumn Header="Vaqt" Width="80" DisplayMemberBinding="{Binding TimeLabel}" />
                    <GridViewColumn Header="Tur" Width="110" DisplayMemberBinding="{Binding TypeLabel}" />
                    <GridViewColumn Header="To'lov" Width="100" DisplayMemberBinding="{Binding PaymentLabel}" />
                    <GridViewColumn Header="Jami" Width="140" DisplayMemberBinding="{Binding TotalLabel}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
