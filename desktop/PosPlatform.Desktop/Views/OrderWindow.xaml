<Window x:Class="PosPlatform.Desktop.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buyurtma"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Height="760" Width="1180" Background="#EEF2F6">

    <Window.Resources>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Dishes -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Grid.Row="0" Height="42" VerticalContentAlignment="Center" Padding="10,0"
                     Margin="0,0,0,12" TextChanged="SearchBox_TextChanged" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DishesControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="150" Height="92" Margin="0,0,12,12" Tag="{Binding}" Click="Dish_Click"
                                    Cursor="Hand" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="12" Padding="12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PriceLabel}" Foreground="#2563EB" FontWeight="Bold" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#EFF6FF" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Order panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TableTitle" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock x:Name="MessageText" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OrderItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SentLabel}" FontSize="10" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource QtyBtn}" Content="−" Tag="{Binding}" Click="Dec_Click" />
                                            <TextBlock Grid.Column="2" Text="{Binding QtyLabel}" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource QtyBtn}" Content="+" Tag="{Binding}" Click="Inc_Click" />
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotalLabel}" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            <Button Grid.Column="5" Style="{StaticResource QtyBtn}" Content="✕" Tag="{Binding}" Click="Remove_Click" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBox Grid.Row="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                                 FontSize="11" Padding="6,2" Tag="izoh"
                                                 ToolTip="Izoh / modifikator (masalan: shakarsiz)" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Jami:" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TotalText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                    </Grid>
                    <Button Style="{StaticResource Pill}" Content="👨‍🍳 Oshxonaga yuborish" Background="#F59E0B" Foreground="White" Margin="0,0,0,8" Click="SendToKitchen_Click" />
                    <Button x:Name="PayButton" Style="{StaticResource Pill}" Content="💳 Hisobni yopish" Background="#16A34A" Foreground="White" Margin="0,0,0,8" Click="Pay_Click" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Pill}" Content="Bekor qilish" Background="#FEE2E2" Foreground="#B91C1C" Click="CancelOrder_Click" />
                        <Button Grid.Column="2" Style="{StaticResource Pill}" Content="Yopish" Click="Close_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
