<Window x:Class="PosPlatform.Desktop.Views.TransferQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O'tkazma to'lovi" Height="600" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F5F7">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summa -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="TO'LOV SUMMASI" FontSize="11" FontWeight="Bold"
                           Foreground="#94A3B8" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="AmountText" Text="0" FontSize="30" FontWeight="Black"
                               Foreground="#0F172A" />
                    <TextBlock Text="so'm" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"
                               VerticalAlignment="Bottom" Margin="6,0,0,5" />
                </StackPanel>
                <TextBlock Text="Mijoz summani ilovada o'zi kiritadi" FontSize="11"
                           Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Karta raqami QR -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="💳 Kartaga o'tkazma" FontSize="14" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <Image x:Name="QrImageView" Width="260" Height="260"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="CardNumberText" FontSize="26" FontWeight="Black"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="Collapsed" />
                <TextBlock x:Name="HintText" FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Tugmalar -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="✓  Pul tushdi — chekni chiqarish" Height="46"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="15"
                    BorderThickness="0" Cursor="Hand" Click="Confirm_Click" />
            <Button Content="Bekor qilish" Height="34" Margin="0,8,0,0"
                    Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0"
                    BorderThickness="1" Cursor="Hand" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
