<Window x:Class="PosPlatform.Desktop.Views.TransferQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O'tkazma to'lovi" Height="620" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F5F7">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summa -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="TO'LOV SUMMASI" FontSize="11" FontWeight="Bold"
                           Foreground="#94A3B8" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="AmountText" Text="0" FontSize="30" FontWeight="Black"
                               Foreground="#0F172A" />
                    <TextBlock Text="so'm" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"
                               VerticalAlignment="Bottom" Margin="6,0,0,5" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Karta -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="💳 Kartaga o'tkazma" FontSize="14" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,14" />

                <!-- Plastik karta ko'rinishi (NBU Platinum uslubida) -->
                <Border Width="410" Height="254" CornerRadius="18" HorizontalAlignment="Center"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0E1726" Offset="0" />
                            <GradientStop Color="#172337" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#1E293B" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                    </Border.Effect>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Yuqori qator: bank brend + karta turi -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="BankShortBox" Background="#E67E22" CornerRadius="4"
                                        Padding="6,4" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="BankShortText" Foreground="White" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="14" />
                                </Border>
                                <TextBlock x:Name="BankNameText" Foreground="White" FontFamily="Segoe UI"
                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CardTypeText" Foreground="#D1D5DB" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- O'rta: chip + kontaktsiz + raqam -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Chip -->
                                <Border Width="46" Height="35" CornerRadius="6" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F6DC95" Offset="0" />
                                            <GradientStop Color="#C99B4E" Offset="0.5" />
                                            <GradientStop Color="#E8C877" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border BorderBrush="#A67C36" BorderThickness="0,1,0,1"
                                                VerticalAlignment="Center" Height="12" Margin="6,0" />
                                        <Border BorderBrush="#A67C36" BorderThickness="1,0,1,0"
                                                HorizontalAlignment="Center" Width="14" Margin="0,4" />
                                    </Grid>
                                </Border>
                                <!-- Kontaktsiz belgi -->
                                <Path Data="M0,0 A6,6 0 0 1 0,12 M4,-2 A9,9 0 0 1 4,16 M8,-4 A12,12 0 0 1 8,20"
                                      Stroke="#D1D5DB" StrokeThickness="1.6" VerticalAlignment="Center"
                                      Margin="14,0,0,0" Opacity="0.9" />
                            </StackPanel>

                            <!-- Karta raqami — Farrington 7B (haqiqiy karta/OCR shrifti), bo'rtma (embossed) effekt -->
                            <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                                <!-- Soya (pastki-o'ng) -->
                                <TextBlock Text="{Binding Text, ElementName=CardNumberText}"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="28"
                                           Foreground="#04101C" Margin="2.2,2.2,0,0" />
                                <!-- Yorug'lik qirrasi (yuqori-chap) -->
                                <TextBlock Text="{Binding Text, ElementName=CardNumberText}"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="28"
                                           Foreground="#8FB6DD" Opacity="0.75" Margin="-1,-1,0,0" />
                                <!-- Asosiy yuz -->
                                <TextBlock x:Name="CardNumberText" Text="0000 0000 0000 0000"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="28"
                                           Foreground="#EEF4FB" />
                            </Grid>
                        </StackPanel>

                        <!-- Pastki qator: muddat + egasi + Mastercard -->
                        <Grid Grid.Row="2">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <!-- Amal qilish muddati -->
                                <StackPanel x:Name="ExpiryPanel" Orientation="Horizontal"
                                            Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="VALID" Foreground="#9CA3AF" FontSize="7" FontWeight="Bold" />
                                        <TextBlock Text="THRU" Foreground="#9CA3AF" FontSize="7" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock x:Name="ExpiryText" Foreground="#EEF4FB" FontSize="16"
                                               FontFamily="pack://application:,,,/Fonts/#Farrington7B"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#04101C" BlurRadius="1" ShadowDepth="1.4" Direction="315" Opacity="0.85" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                                <!-- Karta egasi -->
                                <TextBlock x:Name="HolderText" Text="" Foreground="#EEF4FB" FontSize="16"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B"
                                           HorizontalAlignment="Left">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#04101C" BlurRadius="1" ShadowDepth="1.4" Direction="315" Opacity="0.85" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Mastercard belgisi -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse Width="30" Height="30" Fill="#EB001B" />
                                <Ellipse Width="30" Height="30" Fill="#F79E1B" Opacity="0.9" Margin="-12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="HintText" FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- Tugmalar -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="✓  Pul tushdi — chekni chiqarish" Height="46"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="15"
                    BorderThickness="0" Cursor="Hand" Click="Confirm_Click" />
            <Button Content="Bekor qilish" Height="34" Margin="0,8,0,0"
                    Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0"
                    BorderThickness="1" Cursor="Hand" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
