<Window x:Class="PosPlatform.Desktop.Views.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qaytarish (refund)" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Savdolar" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Yangilash" HorizontalAlignment="Right" Padding="10,5" Click="Refresh_Click" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <Button x:Name="RefundButton" Content="Tanlangan savdoni qaytarish" Height="42"
                    Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand" Click="DoRefund_Click" />
        </StackPanel>

        <ListView x:Name="SalesList" BorderBrush="#E2E5EA">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Chek" Width="150" DisplayMemberBinding="{Binding ReceiptNumber}" />
                    <GridViewColumn Header="Sana" Width="140" DisplayMemberBinding="{Binding DateLabel}" />
                    <GridViewColumn Header="Tur" Width="110" DisplayMemberBinding="{Binding TypeLabel}" />
                    <GridViewColumn Header="To'lov" Width="90" DisplayMemberBinding="{Binding PaymentMethod}" />
                    <GridViewColumn Header="Jami" Width="120" DisplayMemberBinding="{Binding TotalLabel}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
