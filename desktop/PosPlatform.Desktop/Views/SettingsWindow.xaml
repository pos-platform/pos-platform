<Window x:Class="PosPlatform.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sozlamalar" Height="700" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F5F7">
    <StackPanel Margin="22">
        <TextBlock Text="Sozlamalar" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

        <TextBlock Text="Backend manzili (URL)" Foreground="#6B7480" FontWeight="SemiBold" />
        <TextBox x:Name="BaseUrlBox" Height="32" Padding="8,5" Margin="0,4,0,12"
                 VerticalContentAlignment="Center" />

        <CheckBox x:Name="PrinterEnabledBox" Content="Sotuvdan keyin chekni avtomatik chop etish"
                  Margin="0,0,0,10" />

        <TextBlock Text="Printer (bo'sh = standart)" Foreground="#6B7480" FontWeight="SemiBold" />
        <ComboBox x:Name="PrinterCombo" Height="32" Padding="6" IsEditable="True" Margin="0,4,0,8" />

        <TextBlock Text="Kassa stantsiyasi ID (masalan KASSA-1)" Foreground="#6B7480" FontWeight="SemiBold" />
        <TextBox x:Name="TerminalIdBox" Height="32" Padding="8,5" Margin="0,4,0,4"
                 VerticalContentAlignment="Center"
                 ToolTip="Shu PC'dagi fiskal agent FiscalTerminalId bilan bir xil bo'lsin. Har kassada o'z fiskal moduli bo'lsa to'ldiring; bitta modul bo'lsa bo'sh qoldiring." />
        <TextBlock Text="Har kassada alohida fiskal modul bo'lsa to'ldiring; bitta modul bo'lsa bo'sh qoldiring."
                   Foreground="#9AA3AF" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Separator Margin="0,8,0,8" />

        <TextBlock Text="Barcode skaner (COM port)" Foreground="#6B7480" FontWeight="SemiBold" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ScannerPortCombo" Grid.Column="0" Height="32" Padding="6"
                      IsEditable="True" ToolTip="COM port (masalan, COM3). Bo'sh qoldiring = o'chirilgan." />
            <TextBox x:Name="BaudRateBox" Grid.Column="2" Height="32" Padding="8,5"
                     VerticalContentAlignment="Center" ToolTip="Baud rate (standart: 9600)" />
        </Grid>
        <TextBlock Text="Baud rate o'ngda (standart 9600). USB HID skaner uchun bo'sh qoldiring."
                   Foreground="#9AA3AF" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap" />

        <Separator Margin="0,8,0,10" />

        <TextBlock Text="Parolni o'zgartirish" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Text="Joriy parol" Foreground="#6B7480" FontWeight="SemiBold" FontSize="12" />
        <PasswordBox x:Name="CurrentPasswordBox" Height="32" Padding="8,5" Margin="0,4,0,8"
                     VerticalContentAlignment="Center" />
        <TextBlock Text="Yangi parol (kamida 6 belgi)" Foreground="#6B7480" FontWeight="SemiBold" FontSize="12" />
        <PasswordBox x:Name="NewPasswordBox" Height="32" Padding="8,5" Margin="0,4,0,8"
                     VerticalContentAlignment="Center" />
        <TextBlock Text="Yangi parol (tasdiq)" Foreground="#6B7480" FontWeight="SemiBold" FontSize="12" />
        <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Padding="8,5" Margin="0,4,0,8"
                     VerticalContentAlignment="Center" />
        <Button Content="Parolni o'zgartirish" Padding="12,6" HorizontalAlignment="Right"
                Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                Click="ChangePassword_Click" />

        <TextBlock x:Name="MsgText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="🖨 Test chek" Padding="12,6" Margin="0,0,8,0" Click="TestPrint_Click" />
            <Button Content="Bekor" Padding="12,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Saqlash" Padding="14,6" Background="#2563EB" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
