<Window x:Class="PosPlatform.Desktop.Views.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosPlatform — Kassa" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White" Padding="14,10"
                BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PosPlatform" FontWeight="Bold" FontSize="16"
                               Foreground="#2563EB" VerticalAlignment="Center" />
                    <TextBlock x:Name="ShiftInfo" Margin="20,0,0,0"
                               VerticalAlignment="Center" Foreground="#6B7480" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="OpenShiftPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Boshlang'ich naqd:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="OpeningCashBox" Width="100" Text="0"
                                 VerticalContentAlignment="Center" Padding="6,3" />
                        <Button Content="Smenani ochish" Margin="6,0,0,0" Padding="10,5"
                                Click="OpenShift_Click" />
                    </StackPanel>
                    <Button x:Name="CloseShiftButton" Content="Smenani yopish" Padding="10,5"
                            Click="CloseShift_Click" Visibility="Collapsed" />
                    <Button Content="↩ Qaytarish" Padding="10,5" Margin="8,0,0,0" Click="Refund_Click" />
                    <Button x:Name="ReprintButton" Content="🖨 Chek" Padding="10,5" Margin="8,0,0,0"
                            Click="Reprint_Click" IsEnabled="False" />
                    <TextBlock x:Name="UserText" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" />
                    <Button Content="Chiqish" Padding="10,5" Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="38" Padding="10,7"
                         Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProductsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="148" Height="158" Margin="0,0,8,8" Tag="{Binding}"
                                        Click="ProductCard_Click" Cursor="Hand"
                                        Background="White" BorderBrush="#E2E5EA" Padding="8">
                                    <StackPanel>
                                        <Border Height="74" Background="#F4F5F7" CornerRadius="6">
                                            <Image Source="{Binding ImageFull}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,6,0,2" />
                                        <TextBlock Text="{Binding PriceLabel}" Foreground="#2563EB" FontWeight="Bold" />
                                        <TextBlock Foreground="#6B7480" FontSize="11">
                                            <Run Text="qoldiq " /><Run Text="{Binding QtyLabel}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Cart -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#E2E5EA" BorderThickness="1" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Savatcha" FontWeight="Bold"
                               FontSize="16" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="0,8" />
                        <Grid Margin="0,2">
                            <TextBlock Text="Jami" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="TotalText" Text="0" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="To'lov turi" Foreground="#6B7480" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <ComboBox x:Name="PaymentCombo" Height="32" SelectedIndex="0" Padding="6"
                                  SelectionChanged="PaymentCombo_SelectionChanged">
                            <ComboBoxItem Content="Naqd" Tag="Cash" />
                            <ComboBoxItem Content="Karta" Tag="Card" />
                            <ComboBoxItem Content="Aralash" Tag="Mixed" />
                            <ComboBoxItem Content="Nasiya (qarz)" Tag="Debt" />
                        </ComboBox>

                        <StackPanel x:Name="DebtorPanel" Visibility="Collapsed">
                            <TextBlock Text="Qarzdor" Foreground="#6B7480" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <ComboBox x:Name="DebtorCombo" Height="32" Padding="6" DisplayMemberPath="Display" />
                        </StackPanel>

                        <TextBlock Text="Berilgan summa" Foreground="#6B7480" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBox x:Name="PaidBox" Height="32" Text="0" Padding="6,4"
                                 VerticalContentAlignment="Center" TextChanged="PaidBox_TextChanged" />

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Qaytim" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChangeText" Text="0" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <Button x:Name="CheckoutButton" Content="To'lash" Height="44" Margin="0,12,0,0"
                                Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="15"
                                BorderThickness="0" Cursor="Hand" Click="Checkout_Click" />
                        <Button Content="Tozalash" Height="34" Margin="0,8,0,0"
                                Click="Clear_Click" />

                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CartItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Product.Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="−" Width="26" Height="26" Tag="{Binding}" Click="Dec_Click" />
                                            <TextBlock Text="{Binding QtyLabel}" Width="40" TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Button Content="+" Width="26" Height="26" Tag="{Binding}" Click="Inc_Click" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LineTotalLabel}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="6,0,0,0"
                                                Tag="{Binding}" Click="Remove_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
