<Window x:Class="PosPlatform.Desktop.Views.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosPlatform — Kassa"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Height="800" Width="1280" Background="#EEF2F6"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Yumaloq tugma (top-bar) -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kategoriya chip -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ChipActive" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Miqdor +/- tugmasi -->
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DCE3EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mahsulot kartochkasi -->
        <Style x:Key="Card" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="164" />
            <Setter Property="Height" Value="190" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" CornerRadius="14"
                                BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- To'lash tugmasi -->
        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#16A34A" Offset="0" />
                                    <GradientStop Color="#15803D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost tugma -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White" Padding="18,0" Height="66"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PosPlatform" FontWeight="Bold" FontSize="19"
                               Foreground="#2563EB" VerticalAlignment="Center" />
                    <Border Width="1" Height="26" Background="#E2E8F0" Margin="16,0" />
                    <TextBlock x:Name="ShiftInfo" VerticalAlignment="Center" Foreground="#64748B" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="OpenShiftPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Boshlang'ich naqd:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B" />
                        <TextBox x:Name="OpeningCashBox" Width="110" Height="38" Text="0"
                                 VerticalContentAlignment="Center" Padding="8,0" />
                        <Button Content="Smenani ochish" Margin="8,0,0,0" Style="{StaticResource Pill}"
                                Background="#DBEAFE" Foreground="#1D4ED8" Click="OpenShift_Click" />
                    </StackPanel>
                    <Button x:Name="CloseShiftButton" Content="Smenani yopish" Style="{StaticResource Pill}"
                            Background="#FEE2E2" Foreground="#B91C1C" Click="CloseShift_Click" Visibility="Collapsed" />
                    <Button Content="↩ Qaytarish" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="Refund_Click" />
                    <Button Content="⚙" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="Settings_Click" ToolTip="Sozlamalar" />
                    <Border Width="1" Height="26" Background="#E2E8F0" Margin="14,0" />
                    <TextBlock x:Name="UserText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B" />
                    <Button Content="Chiqish" Style="{StaticResource Pill}" Background="#FEE2E2" Foreground="#B91C1C"
                            Margin="12,0,0,0" Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="12" Height="50"
                        BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                    <Grid>
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="15" Padding="16,0"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                        <TextBlock IsHitTestVisible="False" Foreground="#94A3B8" FontSize="15"
                                   VerticalAlignment="Center" Margin="16,0"
                                   Text="🔍   Qidirish yoki shtrix-kodni urang (Enter)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Kategoriya tablari -->
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <StackPanel x:Name="CategoryBar" Orientation="Horizontal" />
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <ItemsControl x:Name="ProductsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Card}" Tag="{Binding}" Click="ProductCard_Click">
                                    <StackPanel>
                                        <Border Height="84" CornerRadius="8" Background="#F1F5F9">
                                            <Image Source="{Binding ImageFull}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#1E293B" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding PriceLabel}" Foreground="#2563EB" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="{Binding QtyLabel, StringFormat='qoldiq: {0}'}"
                                                   Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Cart -->
            <Border Grid.Column="1" Background="White" CornerRadius="14"
                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                <DockPanel>
                    <!-- Parallel savdo tablari -->
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel x:Name="SaleTabs" Orientation="Horizontal" />
                    </ScrollViewer>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Savatcha" FontWeight="Bold" FontSize="18" Foreground="#1E293B" />
                        <Button Content="🗑  Savatni tozalash" Style="{StaticResource GhostBtn}"
                                Background="#FEE2E2" Foreground="#B91C1C" Height="34" Padding="14,0"
                                HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                Click="Clear_Click" ToolTip="Savatchani bo'shatish" />
                    </Grid>

                    <!-- Pastdagi yakun + to'lov -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="#E2E8F0" Margin="0,8" />
                        <Grid Margin="0,4">
                            <TextBlock Text="Jami" FontSize="22" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock x:Name="TotalText" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="#16A34A" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="To'lov turi" Foreground="#64748B" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox x:Name="PaymentCombo" Height="40" SelectedIndex="0" Padding="8" FontSize="14"
                                  SelectionChanged="PaymentCombo_SelectionChanged">
                            <ComboBoxItem Content="💵  Naqd" Tag="Cash" />
                            <ComboBoxItem Content="💳  Karta" Tag="Card" />
                            <ComboBoxItem Content="🔀  Aralash" Tag="Mixed" />
                            <ComboBoxItem Content="📒  Nasiya (qarz)" Tag="Debt" />
                        </ComboBox>

                        <StackPanel x:Name="DebtorPanel" Visibility="Collapsed">
                            <TextBlock Text="Qarzdor" Foreground="#64748B" FontWeight="SemiBold" Margin="0,10,0,4" />
                            <ComboBox x:Name="DebtorCombo" Height="40" Padding="8" FontSize="14" DisplayMemberPath="Display" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Berilgan summa" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="💵  To'liq summa" Style="{StaticResource GhostBtn}"
                                    Background="#DBEAFE" Foreground="#1D4ED8" Height="30" Padding="12,0"
                                    FontSize="12" FontWeight="SemiBold" Click="ExactCash_Click"
                                    ToolTip="Berilgan summani jamiga tenglashtirish" />
                        </Grid>
                        <TextBox x:Name="PaidBox" Height="42" Text="0" Padding="12,0" FontSize="16"
                                 VerticalContentAlignment="Center" Margin="0,4,0,0" TextChanged="PaidBox_TextChanged" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Qaytim" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock x:Name="ChangeText" Text="0" FontWeight="Bold" FontSize="15"
                                       Foreground="#1E293B" HorizontalAlignment="Right" />
                        </Grid>

                        <Button x:Name="CheckoutButton" Content="To'lash  (F12)" Style="{StaticResource PayBtn}"
                                Margin="0,14,0,0" Click="Checkout_Click" />

                        <Button x:Name="ReprintButton" Content="🖨  Chekni ko'rish va chop etish"
                                Style="{StaticResource GhostBtn}" Margin="0,8,0,0" Height="40"
                                Click="Reprint_Click" IsEnabled="False"
                                ToolTip="Oxirgi chekni ko'rib chiqib chop etish" />

                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontWeight="SemiBold" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Savat qatorlari -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl x:Name="CartItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="10,8" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                                           Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LineTotalLabel}"
                                                           Foreground="#2563EB" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="−" Style="{StaticResource QtyBtn}" Tag="{Binding}" Click="Dec_Click" />
                                                <TextBlock Text="{Binding QtyLabel}" Width="38" TextAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <Button Content="+" Style="{StaticResource QtyBtn}" Tag="{Binding}" Click="Inc_Click" />
                                                <Button Content="✕" Style="{StaticResource QtyBtn}" Background="#FEE2E2"
                                                        Foreground="#DC2626" FontSize="13" Margin="8,0,0,0"
                                                        Tag="{Binding}" Click="Remove_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
