<Window x:Class="PosPlatform.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosPlatform — Kirish"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Height="800" Width="1200" Background="White">

    <Window.Resources>
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#D7DBE2" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,6,0,16" />
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0" />
                                    <GradientStop Color="#1D4ED8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E3A8A" Offset="0" />
                <GradientStop Color="#2563EB" Offset="0.5" />
                <GradientStop Color="#0EA5A4" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="20" Padding="44,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.35" Color="#0B1B3A" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="PosPlatform" FontSize="34" FontWeight="Bold"
                           Foreground="#2563EB" HorizontalAlignment="Center" />
                <TextBlock Text="Kassir kirishi" FontSize="15" Foreground="#6B7480"
                           HorizontalAlignment="Center" Margin="0,4,0,28" />

                <TextBlock Text="Foydalanuvchi" Foreground="#475569" FontWeight="SemiBold" FontSize="14" />
                <Border Style="{StaticResource InputBorder}">
                    <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" Text="admin" />
                </Border>

                <TextBlock Text="Parol" Foreground="#475569" FontWeight="SemiBold" FontSize="14" />
                <Border Style="{StaticResource InputBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource Field}"
                                     KeyDown="PasswordBox_KeyDown" Grid.Column="0" />
                        <TextBox x:Name="PasswordVisible" Style="{StaticResource Field}"
                                 KeyDown="PasswordBox_KeyDown" Grid.Column="0" Visibility="Collapsed" />
                        <Button x:Name="EyeButton" Grid.Column="1" Content="👁" Width="46"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="16" Click="ToggleShowPassword" ToolTip="Parolni ko'rsatish" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,0,0,12" Visibility="Collapsed" />

                <Button x:Name="LoginButton" Content="Kirish" Style="{StaticResource PrimaryBtn}"
                        Click="LoginButton_Click" />

                <Button Content="⚙ Sozlamalar" Background="Transparent" BorderThickness="0"
                        Foreground="#6B7480" FontSize="13" Cursor="Hand" HorizontalAlignment="Center"
                        Margin="0,18,0,0" Click="Settings_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
