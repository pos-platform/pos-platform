<Window x:Class="PosCloud.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosCloud — Kirish"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Height="800" Width="1200" Background="White">

    <Window.Resources>
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#D7DBE2" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,6,0,16" />
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11"
                                Background="{StaticResource PrimaryGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrandGradientBrush}">

        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="20" Padding="44,36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.35" Color="#0B1B3A" />
            </Border.Effect>
            <StackPanel>
                <!-- Logo -->
                <Image x:Name="LogoImage" Width="110" Height="96"
                       HorizontalAlignment="Center" Margin="0,0,0,10"
                       Source="{StaticResource AppLogo}"/>
                <TextBlock Text="PosCloud" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Kassir kirishi" FontSize="15" Foreground="#6B7480"
                           HorizontalAlignment="Center" Margin="0,4,0,24" />

                <TextBlock Text="Foydalanuvchi" Foreground="#475569" FontWeight="SemiBold" FontSize="14" />
                <Border Style="{StaticResource InputBorder}">
                    <Grid>
                        <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" />
                        <TextBlock IsHitTestVisible="False" Text="Foydalanuvchi nomi"
                                   Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" Margin="14,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <TextBlock Text="Parol" Foreground="#475569" FontWeight="SemiBold" FontSize="14" />
                <Border Style="{StaticResource InputBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource Field}"
                                     KeyDown="PasswordBox_KeyDown" Grid.Column="0" />
                        <TextBox x:Name="PasswordVisible" Style="{StaticResource Field}"
                                 KeyDown="PasswordBox_KeyDown" Grid.Column="0" Visibility="Collapsed" />
                        <Button x:Name="EyeButton" Grid.Column="1" Content="👁" Width="46"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="16" Click="ToggleShowPassword" ToolTip="Parolni ko'rsatish" />
                    </Grid>
                </Border>

                <CheckBox x:Name="RememberBox" Content="Eslab qolish" Foreground="#475569"
                          FontSize="14" Margin="0,0,0,14"
                          ToolTip="Login va parol shu kompyuterda shifrlangan holda saqlanadi — keyingi safar qayta yozish shart emas." />

                <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,0,0,12" Visibility="Collapsed" />

                <Button x:Name="LoginButton" Content="Kirish" Style="{StaticResource PrimaryBtn}"
                        Click="LoginButton_Click" />

                <Button Content="⚙ Sozlamalar" Background="Transparent" BorderThickness="0"
                        Foreground="#6B7480" FontSize="13" Cursor="Hand" HorizontalAlignment="Center"
                        Margin="0,18,0,0" Click="Settings_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
