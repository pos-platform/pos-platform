<Window x:Class="PosCloud.Desktop.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chek" Width="344" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#EEF1F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Chek ko'rinishi" FontSize="17" FontWeight="Bold"
                   Foreground="#1E293B" Margin="0,0,0,12" />

        <!-- Qog'oz chek ko'rinishi — qolgan bo'sh joyni to'ldiradi va uzun bo'lsa scroll qiladi
             (tugmalar doim pastda ko'rinib turadi). -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="0"
                Width="300" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                BorderBrush="#D7DDE5" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" />
            </Border.Effect>
            <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="White" Margin="8" />
        </Border>

        <StackPanel x:Name="ActionButtons" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Yopish" Width="100" Height="42" Margin="0,0,8,0"
                    IsCancel="True" Click="Close_Click"
                    Background="White" BorderBrush="#CBD5E1" />
            <Button x:Name="PrintButton" Content="🖨  Chop etish" Width="160" Height="42"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Click="Print_Click" />
        </StackPanel>
    </Grid>
</Window>
