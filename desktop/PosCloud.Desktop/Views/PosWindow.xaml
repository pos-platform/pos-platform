<Window x:Class="PosCloud.Desktop.Views.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:PosCloud.Desktop.Services"
        Title="PosCloud — Kassa"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Height="800" Width="1280" Background="#F1F5F9"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Rasmni cheklangan o'lchamda (asinxron) yuklaydigan, keshlanadigan konverter -->
        <svc:ProductImageConverter x:Key="ProductImage" />

        <!-- Yumaloq tugma (top-bar) -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kategoriya chip -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="ChipActive" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Miqdor +/- tugmasi (oq fon, ramka) -->
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Qatordagi o'chirish (✕) tugmasi -->
        <Style x:Key="RowDeleteBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="#FECACA" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DC2626" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#DC2626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mahsulot kartochkasi (ixcham) -->
        <Style x:Key="Card" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" CornerRadius="12"
                                BorderBrush="#E2E8F0" BorderThickness="1" Padding="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- To'lov turi tab tugmasi -->
        <Style x:Key="PayTab" TargetType="Button">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PayTabActive" TargetType="Button" BasedOn="{StaticResource PayTab}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Rangli (solid ko'k) tugma -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#2563EB" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Katta "Chop etish" tugmasi (indigo gradient — ko'k tab/aksentlardan farqlanadi) -->
        <Style x:Key="PrintBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6366F1" Offset="0" />
                                    <GradientStop Color="#4338CA" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.93" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kichik yashil tugma (yashil-teal gradient) -->
        <Style x:Key="PaySmallBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#059669" Offset="0" />
                                    <GradientStop Color="#0D9488" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.93" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost tugma -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pul kiritish maydoni (yumaloq, focus-ramkali) -->
        <Style x:Key="MoneyInput" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="SelectionBrush" Value="#BFDBFE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="White" CornerRadius="10"
                                BorderBrush="#CBD5E1" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="b" Property="Background" Value="#F8FBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Obuna to'lovi eslatmasi (muddat 7 kun ichida tugasa) -->
        <Border x:Name="LicenseBanner" Grid.Row="0" Background="#FFF1F1" Padding="18,9"
                BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <TextBlock x:Name="LicenseBannerText" Foreground="#DC2626" FontWeight="Bold"
                       FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" />
        </Border>

        <!-- Top bar -->
        <Border Grid.Row="1" Background="White" Padding="18,0" Height="62"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TopLogoImage" Source="{StaticResource AppLogo}"
                           Width="38" Height="32"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PosCloud" FontWeight="Bold" FontSize="17"
                                   Foreground="#0F172A" />
                        <TextBlock x:Name="ShiftInfo" Foreground="#64748B" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="OpenShiftPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Boshlang'ich naqd:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B" />
                        <TextBox x:Name="OpeningCashBox" Width="110" Height="38" Text="0"
                                 VerticalContentAlignment="Center" Padding="8,0" />
                        <Button Content="Smenani ochish" Margin="8,0,0,0" Style="{StaticResource Pill}"
                                Background="#DBEAFE" Foreground="{StaticResource PrimaryDarkBrush}" Click="OpenShift_Click" />
                    </StackPanel>
                    <Button x:Name="OnlineOrdersButton" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="OnlineOrders_Click"
                            Visibility="Collapsed" ToolTip="Mobil ilovadan kelgan buyurtmalar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒 Online" VerticalAlignment="Center" />
                            <Border x:Name="OnlineOrdersBadge" Background="#C2410C" CornerRadius="9" Padding="7,0" Margin="6,0,0,0"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="OnlineOrdersBadgeText" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="📋 Savdolar" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="SalesHistory_Click"
                            ToolTip="Kunlik savdolar va chekni qayta chop etish" />
                    <Button Content="↩ Qaytarish" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="Refund_Click" />
                    <!-- Tovarlar ro'yxati oxirgi marta qachon tekshirilgani (avtomatik yangilanadi) -->
                    <TextBlock x:Name="CatalogStatusText" Text="" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Tovarlar va narxlar avtomatik yangilanadi (har daqiqada tekshiriladi)" />
                    <!-- Oflayn ko'rsatkich + sinxronlash tugmasi -->
                    <Border x:Name="OnlineBadge" CornerRadius="10" Padding="8,4" Margin="0,0,8,0"
                            Background="#DCFCE7" ToolTip="Internet bor — onlayn rejim">
                        <TextBlock x:Name="OnlineText" Text="● Onlayn" Foreground="#16A34A"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="SyncButton" Style="{StaticResource Pill}" Margin="0,0,8,0"
                            Click="Sync_Click" Visibility="Collapsed" ToolTip="Oflayn savdolarni serverga yuborish">
                        <TextBlock x:Name="SyncText" Text="↑ Sync" FontSize="12"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="Settings_Click" ToolTip="Sozlamalar">
                        <Grid>
                            <TextBlock Text="⚙" />
                            <Ellipse x:Name="UpdateBadge" Width="9" Height="9" Fill="#DC2626"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-3,-7,0" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Border Width="1" Height="26" Background="#E2E8F0" Margin="2,0,12,0" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                            Padding="6,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="UserText" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="12" Foreground="#1E293B" Margin="8,0,4,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CloseShiftButton" Content="Smenani yopish" Style="{StaticResource Pill}"
                            Background="#FEE2E2" Foreground="#B91C1C" Margin="0,0,8,0"
                            Click="CloseShift_Click" Visibility="Collapsed" />
                    <Button Content="Chiqish" Style="{StaticResource Pill}" Background="#FEE2E2" Foreground="#B91C1C"
                            Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <!-- Savatcha (asosiy ish maydoni) — ~58% -->
                <ColumnDefinition Width="7*" />
                <!-- Mahsulotlar — ~42% -->
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- Cart (chap tomon, asosiy) -->
            <Border Grid.Column="0" Margin="0,0,12,0" Background="White" CornerRadius="14"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="14" ShadowDepth="1" Opacity="0.14" />
                </Border.Effect>
                <DockPanel Margin="16">
                    <!-- Parallel savdo tablari + savatni tozalash -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                            <StackPanel x:Name="SaleTabs" Orientation="Horizontal" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🎁  Bonus karta" Style="{StaticResource GhostBtn}"
                                    Background="#F5F3FF" Foreground="#6D28D9" Height="34" Padding="14,0"
                                    Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"
                                    Click="BonusCard_Click"
                                    ToolTip="Mijoz ilovasidagi bonus karta QR kodini skanerlang" />
                            <Button Content="🗑  Savatni tozalash" Style="{StaticResource GhostBtn}"
                                    Background="#FEF2F2" Foreground="#B91C1C" Height="34" Padding="14,0"
                                    FontSize="12" FontWeight="SemiBold"
                                    Click="Clear_Click" ToolTip="Savatchani bo'shatish" />
                        </StackPanel>
                    </Grid>

                    <!-- Bonus karta orqali biriktirilgan mijoz (joriy savdo tabi uchun) -->
                    <Border x:Name="CustomerChip" DockPanel.Dock="Top" Visibility="Collapsed"
                            Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                            CornerRadius="10" Padding="12,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomerChipText" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#5B21B6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="×" Width="26" Height="26" FontSize="16"
                                    FontWeight="Bold" Padding="0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="#7C3AED"
                                    Click="DetachCustomer_Click" ToolTip="Mijozni savdodan olib tashlash" />
                        </Grid>
                    </Border>

                    <!-- Pastdagi yakun + to'lov -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" CornerRadius="12"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="9" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid x:Name="ItemCountRow" Margin="0,0,0,4" Visibility="Collapsed">
                                <TextBlock Text="Tovarlar soni" FontSize="12" Foreground="#94A3B8"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ItemCountText" Text="0 ta" FontSize="12" FontWeight="Bold"
                                           Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Jami summa kartochkasi -->
                            <Border Background="White" CornerRadius="9" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Padding="10,5" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="JAMI SUMMA:" FontSize="12" FontWeight="Bold"
                                               Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TotalText" Text="0" FontSize="20" FontWeight="Black"
                                                   Foreground="#0F172A" />
                                        <TextBlock Text="so'm" FontSize="12" FontWeight="Bold"
                                                   Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Ball bilan to'lash (mijoz biriktirilganda) -->
                            <Border x:Name="RedeemPanel" Visibility="Collapsed" Background="#F5F3FF"
                                    CornerRadius="9" BorderBrush="#DDD6FE" BorderThickness="1"
                                    Padding="10,5" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="BALL BILAN TO'LASH" FontSize="11" FontWeight="Bold"
                                                       Foreground="#6D28D9" />
                                            <TextBlock x:Name="RedeemMaxText" FontSize="10" Foreground="#8B5CF6" />
                                        </StackPanel>
                                        <TextBox x:Name="RedeemBox" Grid.Column="1" Height="30" Text="0"
                                                 Style="{StaticResource MoneyInput}" FontSize="14" FontWeight="Bold"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="RedeemBox_TextChanged" />
                                        <Button Grid.Column="2" Content="Hammasi" Style="{StaticResource GhostBtn}"
                                                Background="#EDE9FE" Foreground="#6D28D9" Height="30" Padding="10,0"
                                                Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                Click="RedeemAll_Click" ToolTip="Mumkin bo'lgan maksimal ballni ishlatish" />
                                    </Grid>
                                    <TextBlock x:Name="RedeemSummaryText" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#5B21B6" Margin="0,3,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- To'lov turi -->
                            <UniformGrid Columns="5" Margin="0,0,0,6">
                                <Button x:Name="PayCard" Content="💳 Karta" Tag="Card" Margin="0,0,6,0"
                                        Style="{StaticResource PayTabActive}" Click="PayTab_Click" />
                                <Button x:Name="PayCash" Content="💵 Naqd" Tag="Cash" Margin="0,0,6,0"
                                        Style="{StaticResource PayTab}" Click="PayTab_Click" />
                                <Button x:Name="PayTransfer" Content="📱 O'tkazma" Tag="Transfer" Margin="0,0,6,0"
                                        Style="{StaticResource PayTab}" Click="PayTab_Click"
                                        ToolTip="Kartaga o'tkazma orqali to'lov" />
                                <Button x:Name="PayMixed" Content="🔀 Aralash" Tag="Mixed" Margin="0,0,6,0"
                                        Style="{StaticResource PayTab}" Click="PayTab_Click" />
                                <Button x:Name="PayDebt" Content="📒 Nasiya" Tag="Debt"
                                        Style="{StaticResource PayTab}" Click="PayTab_Click" />
                            </UniformGrid>

                            <StackPanel x:Name="DebtorPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBlock Text="QARZDOR" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />
                                <ComboBox x:Name="DebtorCombo" Height="42" Padding="10" FontSize="14" DisplayMemberPath="Display" />
                            </StackPanel>

                            <!-- Olingan summa + Qaytim -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="PaidLabel" Text="OLINGAN SUMMA" Foreground="#94A3B8" FontWeight="Bold"
                                               FontSize="11" Margin="0,0,0,4" />
                                    <TextBox x:Name="PaidBox" Height="38" Text="0" Style="{StaticResource MoneyInput}"
                                             FontSize="18" FontWeight="Bold" VerticalContentAlignment="Center"
                                             TextChanged="PaidBox_TextChanged" />
                                    <Button x:Name="ExactCashButton" Content="💵  To'liq summani qo'yish"
                                            Style="{StaticResource AccentBtn}"
                                            Height="28" Margin="0,5,0,0" FontSize="12"
                                            Click="ExactCash_Click"
                                            ToolTip="Mijoz to'liq summa berdi — olingan summani jamiga tenglashtiradi (qaytimsiz)" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="ChangeLabel" Text="QAYTIM" Foreground="#94A3B8" FontWeight="Bold"
                                               FontSize="11" Margin="0,0,0,4" />
                                    <Border Height="38" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                            CornerRadius="10" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ChangeText" Text="0" FontWeight="Black" FontSize="16"
                                                       Foreground="#C2410C" HorizontalAlignment="Left" />
                                            <TextBlock Text="so'm" FontSize="10" FontWeight="Bold"
                                                       Foreground="#EA9A6B" HorizontalAlignment="Left" Margin="0,-2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="ReprintButton" Content="🖨  Chop etish"
                                    Style="{StaticResource PrintBtn}" Height="44" Margin="0,8,0,0"
                                    Click="Reprint_Click"
                                    ToolTip="Oxirgi to'lov qilingan chekni chop etish" />

                            <Button x:Name="CheckoutButton" Content="✓  To'lash va Chek chiqarish (F12)"
                                    Style="{StaticResource PaySmallBtn}" Margin="0,5,0,0" Click="Checkout_Click" />

                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="13"
                                       FontWeight="SemiBold" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Savat jadvali -->
                    <Border BorderBrush="#EEF2F6" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <!-- Jadval sarlavhasi -->
                            <Border DockPanel.Dock="Top" Background="#F8FAFC" CornerRadius="9,9,0,0"
                                    BorderBrush="#EEF2F6" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MAHSULOT / KOD / QOLDIQ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="NARX / CHEGIRMA" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="JAMI SUMMA" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="SONI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="" />
                                </Grid>
                            </Border>

                            <!-- Bo'sh savat holati -->
                            <TextBlock x:Name="EmptyCartHint" DockPanel.Dock="Bottom"
                                       Text="🛒  Savatcha bo'sh — mahsulotni tanlang yoki shtrix-kodni skanerlang"
                                       Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,40" TextAlignment="Center" />

                            <!-- Qatorlar -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4">
                                <ItemsControl x:Name="CartItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                    Padding="4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Mahsulot / kod / qoldiq -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Product.Name}" FontWeight="Bold" FontSize="13"
                                                                   Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Product.Barcode}" FontSize="10"
                                                                       Foreground="#94A3B8" FontFamily="Consolas" VerticalAlignment="Center" />
                                                            <Border Background="#ECFDF5" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding Product.QtyLabel, StringFormat='Qoldiq: {0}'}"
                                                                           FontSize="9" FontWeight="SemiBold" Foreground="#047857" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Asl narxi + chegirma (kichik, ostida) -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Product.PriceLabel}" FontSize="12"
                                                                   Foreground="#64748B" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding DiscountLabel}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <!-- Jami summa -->
                                                    <TextBlock Grid.Column="2" Text="{Binding LineTotalLabel}" FontSize="14" FontWeight="Bold"
                                                               Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Soni (+/-) -->
                                                    <Border Grid.Column="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                            CornerRadius="9" Padding="2" Margin="6,0" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="−" Style="{StaticResource QtyBtn}" Tag="{Binding}" Click="Dec_Click" />
                                                            <TextBlock Grid.Column="1" Text="{Binding QtyLabel}" TextAlignment="Center" FontSize="14"
                                                                       VerticalAlignment="Center" FontWeight="Black" Foreground="#0F172A" />
                                                            <Button Grid.Column="2" Content="+" Style="{StaticResource QtyBtn}" Tag="{Binding}" Click="Inc_Click" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- O'chirish -->
                                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource RowDeleteBtn}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Tag="{Binding}" Click="Remove_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Products (o'ng tomon) -->
            <DockPanel Grid.Column="1" Margin="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Height="46"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="14" Padding="16,0"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                            <TextBlock IsHitTestVisible="False" Foreground="#94A3B8" FontSize="14"
                                       VerticalAlignment="Center" Margin="16,0"
                                       Text="🔍   Tezkor qidiruv yoki shtrix-kod (Enter)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource Pill}"
                            Background="White" Width="46" Height="46" Margin="8,0,0,0"
                            ToolTip="Mahsulotlarni yangilash" Click="Refresh_Click">
                        <TextBlock FontSize="17">↻</TextBlock>
                    </Button>
                </Grid>

                <!-- Kategoriya tablari -->
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <StackPanel x:Name="CategoryBar" Orientation="Horizontal" />
                </ScrollViewer>

                <Grid>
                    <!-- Mahsulotlar ro'yxati: virtualizatsiya yoqilgan ListBox.
                         Har bir element — 4 tadan mahsulotli qator; ListBox faqat ko'rinib
                         turgan qatorlarni yaratadi (VirtualizingStackPanel + Recycling),
                         shu sabab minglab mahsulotda ham tez ochiladi va aylanadi. -->
                    <ListBox x:Name="ProductsControl" Background="Transparent" BorderThickness="0"
                             Padding="2" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Card}" Tag="{Binding}" Click="ProductCard_Click">
                                                <StackPanel>
                                                    <Border Height="52" CornerRadius="8" Background="#F1F5F9">
                                                        <Image Source="{Binding ImageFull, Converter={StaticResource ProductImage}}"
                                                               Stretch="Uniform" Margin="4"
                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"
                                                               Foreground="#1E293B" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,6,0,3"
                                                               TextAlignment="Center" HorizontalAlignment="Center" />
                                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="0,3">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding PriceLabel}" Foreground="#2563EB" FontWeight="Bold"
                                                                       FontSize="12" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding QtyLabel, StringFormat='Qoldiq: {0}'}"
                                                                       Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Loading overlay -->
                    <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#CCFFFFFF" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="5" />
                            <TextBlock Text="Yuklanmoqda..." HorizontalAlignment="Center" Margin="0,12,0,0"
                                       FontWeight="SemiBold" FontSize="14" Foreground="#475569" />
                        </StackPanel>
                    </Border>
                    <!-- Skan natijasi toast (avtomatik yo'qoladi) -->
                    <Border x:Name="ScanToast" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,8,0,0" CornerRadius="12" Padding="22,14" Background="#FEE2E2"
                            BorderBrush="#FCA5A5" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#94A3B8" BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
                        </Border.Effect>
                        <TextBlock x:Name="ScanToastText" Text="Tovar topilmadi" FontWeight="Bold" FontSize="18"
                                   Foreground="#B91C1C" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
