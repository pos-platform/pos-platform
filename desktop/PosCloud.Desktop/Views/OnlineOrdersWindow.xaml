<Window x:Class="PosCloud.Desktop.Views.OnlineOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online buyurtmalar" Height="820" Width="1380" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#EEEDE7">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F1EFEA" />
            <Setter Property="BorderBrush" Value="#D2CFC5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#0B6B45" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B6B45" />
        </Style>

        <!-- Doskadagi kartochka -->
        <DataTemplate x:Key="OrderCard">
            <Button Click="Card_Click" Tag="{Binding}" Margin="0,0,0,8" Padding="0" Cursor="Hand"
                    Background="White" BorderBrush="#E4E2DA" BorderThickness="1" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="10">
                    <DockPanel>
                        <TextBlock Text="{Binding AgeText}" DockPanel.Dock="Right" FontSize="11" Foreground="#5B6660" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                    </DockPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Border Background="#F1EFEA" CornerRadius="5" Padding="6,2" Margin="0,0,4,0">
                            <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#FDEBDD" CornerRadius="5" Padding="6,2">
                            <TextBlock Text="{Binding PaymentText}" FontSize="11" FontWeight="SemiBold" Foreground="#9A3412" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#5B6660" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CustomerLine}" FontSize="12" Foreground="#3A4540" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CourierText}" Visibility="{Binding CourierVisibility}" FontSize="12" Foreground="#0B6B45" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding TotalText}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Sarlavha -->
        <Border DockPanel.Dock="Top" Background="#16201B" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionText" Foreground="#C9D1CC" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <CheckBox x:Name="AcceptingCheck" Content="Buyurtma qabul qilish yoqilgan" Foreground="White"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="Accepting_Changed" Unchecked="Accepting_Changed" />
                    <Button x:Name="CourierCashButton" Content="Kuryer pullari" Padding="12,4" Margin="0,0,8,0" Click="CourierCash_Click"
                            ToolTip="Kassaga hali topshirilmagan kuryer naqdlari" />
                    <Button Content="Yangilash" Padding="12,4" Click="Refresh_Click" />
                </StackPanel>
                <TextBlock Text="Online buyurtmalar" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Xabar qatori -->
        <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" Margin="16,4,16,8" FontSize="13" TextWrapping="Wrap" />

        <Grid Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- Doska: 4 ustun -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E3E1DA" CornerRadius="12" Padding="8" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock x:Name="NewHeader" DockPanel.Dock="Top" Text="Yangi" FontWeight="Bold" Margin="4,0,0,8" Foreground="#C2410C" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NewList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="#E3E1DA" CornerRadius="12" Padding="8" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock x:Name="PickingHeader" DockPanel.Dock="Top" Text="Yig'ilmoqda" FontWeight="Bold" Margin="4,0,0,8" Foreground="#B7791F" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PickingList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="#E3E1DA" CornerRadius="12" Padding="8" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock x:Name="ReadyHeader" DockPanel.Dock="Top" Text="Tayyor" FontWeight="Bold" Margin="4,0,0,8" Foreground="#2D5BD0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ReadyList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="3" Background="#E3E1DA" CornerRadius="12" Padding="8">
                    <DockPanel>
                        <TextBlock x:Name="WayHeader" DockPanel.Dock="Top" Text="Yo'lda" FontWeight="Bold" Margin="4,0,0,8" Foreground="#0B6B45" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WayList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tanlangan buyurtma / yig'ish paneli -->
            <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#DEDBD2" BorderThickness="1" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetail" Text="Buyurtmani tanlang" Foreground="#5B6660"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Yig'ish varag'i" Style="{StaticResource ActionBtn}" Margin="0"
                                        Click="PrintSheet_Click" />
                                <StackPanel>
                                    <Border Background="#FDEBDD" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DetailStatus" FontSize="12" FontWeight="Bold" Foreground="#9A3412" />
                                    </Border>
                                    <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="DetailCustomer" FontSize="13" Foreground="#3A4540" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailAddress" FontSize="13" Foreground="#3A4540" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailComment" FontSize="13" Foreground="#9A3412" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailCourier" FontSize="13" FontWeight="SemiBold" Foreground="#0B6B45" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailPolicy" FontSize="12" Foreground="#5B6660" Margin="0,2,0,0" />

                            <Border x:Name="ScanBox" BorderBrush="#0B6B45" BorderThickness="2" CornerRadius="10" Background="#F6FBF8"
                                    Margin="0,10,0,0" Padding="10,0" Height="44">
                                <TextBox x:Name="ScanInput" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="14" KeyDown="ScanInput_KeyDown" ToolTip="Shtrix-kodni skanerlang — qator belgilanadi" />
                            </Border>
                            <DockPanel Margin="0,8,0,4">
                                <TextBlock x:Name="PickedText" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="Yig'ildi" FontWeight="Bold" FontSize="12" />
                            </DockPanel>
                            <ProgressBar x:Name="PickedProgress" Height="8" Foreground="#0B6B45" Background="#ECEAE3" BorderThickness="0" />
                        </StackPanel>

                        <!-- Amallar -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock x:Name="DetailDiscounts" FontSize="12" Foreground="#9A3412" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="DetailTotal" DockPanel.Dock="Right" FontSize="18" FontWeight="Bold" />
                                <TextBlock x:Name="DetailPayment" FontSize="13" Foreground="#5B6660" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel x:Name="ActionsPanel" />
                        </StackPanel>

                        <ListBox x:Name="ItemsList" Margin="0,8,0,0" BorderBrush="#ECEAE3" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,4">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" IsEnabled="{Binding CanCheck}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.QuantityText}" FontWeight="Bold" FontSize="14" Margin="6,0" VerticalAlignment="Center" />
                                            <Button Content="Markirovka kodi" Tag="{Binding}" Click="ItemMarking_Click" Padding="6,2" Margin="2,0"
                                                    Visibility="{Binding MarkingEditVisibility}" />
                                            <Button Content="Miqdor" Tag="{Binding}" Click="ItemQty_Click" Padding="6,2" Margin="2,0"
                                                    Visibility="{Binding EditVisibility}" />
                                            <Button Content="Almashtirish" Tag="{Binding}" Click="ItemReplace_Click" Padding="6,2" Margin="2,0"
                                                    Visibility="{Binding EditVisibility}" />
                                            <Button Content="Yo'q" Tag="{Binding}" Click="ItemRemove_Click" Padding="6,2" Margin="2,0"
                                                    Visibility="{Binding EditVisibility}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.ProductName}" FontWeight="SemiBold" FontSize="14"
                                                       TextDecorations="{Binding Strike}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Item.CodeText}" FontSize="11" Foreground="#5B6660" />
                                            <TextBlock Text="{Binding Item.MarkingText}" Visibility="{Binding Item.MarkingVisibility}"
                                                       Foreground="{Binding Item.MarkingBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
