<Window x:Class="PosCloud.Desktop.Views.OnlineOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online buyurtmalar" Height="820" Width="1380" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Kassa oynasi (PosWindow) bilan bir xil uslub: yumaloq "pill" tugmalar, slate ranglar -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#059669" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="HeaderBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MiniDangerBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>

        <!-- Buyurtma qabul qilish: switch ko'rinishidagi CheckBox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#CBD5E1" VerticalAlignment="Center">
                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White" Margin="3,0" HorizontalAlignment="Left" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#10B981" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Doska ustuni -->
        <Style x:Key="Column" TargetType="Border">
            <Setter Property="Background" Value="#E9EEF5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!-- Doskadagi kartochka -->
        <DataTemplate x:Key="OrderCard">
            <Button Click="Card_Click" Tag="{Binding}" Margin="0,0,0,10" Cursor="Hand" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding AgeText}" DockPanel.Dock="Right" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Tag}" Background="#EEF2FF" Visibility="{Binding PreorderVisibility}">
                            <TextBlock Text="{Binding PreorderText}" FontSize="11" FontWeight="SemiBold" Foreground="#4338CA" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="#F1F5F9">
                            <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="#FFF7ED">
                            <TextBlock Text="{Binding PaymentText}" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{Binding SubstitutionBackground}">
                            <TextBlock Text="{Binding SubstitutionText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SubstitutionForeground}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding CustomerLine}" FontSize="12" Foreground="#475569" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CourierText}" Visibility="{Binding CourierVisibility}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#047857" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CourierOfferText}" Visibility="{Binding CourierOfferVisibility}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding CourierOfferBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Yig'ish ro'yxati qatori: tanlash ko'k fonini o'chiramiz -->
        <Style x:Key="ItemRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Sarlavha -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge" Background="#ECFDF5" CornerRadius="10" Padding="12,0" Height="38" Margin="0,0,14,0">
                        <TextBlock x:Name="ConnectionText" Foreground="#047857" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <CheckBox x:Name="AcceptingCheck" Style="{StaticResource Switch}" Content="Buyurtma qabul qilinadi"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="Accepting_Changed" Unchecked="Accepting_Changed" />
                    <Button x:Name="ReturnsButton" Style="{StaticResource HeaderBtn}" Content="Qaytarishlar" Click="Returns_Click"
                            ToolTip="Mijozlarning qaytarish so'rovlari" />
                    <Button x:Name="RejectedButton" Style="{StaticResource HeaderBtn}" Content="Kuryer qaytargan tovarlar" Click="Rejected_Click"
                            ToolTip="Eshik oldida mijoz rad etgan, do'konga qaytariladigan tovarlar" />
                    <Button x:Name="CourierCashButton" Style="{StaticResource HeaderBtn}" Content="Kuryer pullari" Click="CourierCash_Click"
                            ToolTip="Kassaga hali topshirilmagan kuryer naqdlari" />
                    <Button Style="{StaticResource HeaderBtn}" Content="↻  Yangilash" Click="Refresh_Click"
                            Background="#EFF6FF" BorderBrush="#BFDBFE" Foreground="#1D4ED8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" Margin="0,0,12,0">
                        <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Online buyurtmalar" Foreground="#0F172A" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Mobil ilovadan kelgan buyurtmalar" Foreground="#64748B" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Xabar qatori -->
        <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" Margin="20,6,20,10" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- Doska: 4 ustun -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Column}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,12">
                            <Ellipse Width="10" Height="10" Fill="#F97316" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="NewHeader" Style="{StaticResource ColumnTitle}" Text="Yangi" Foreground="#C2410C" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NewList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Column}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,12">
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PickingHeader" Style="{StaticResource ColumnTitle}" Text="Yig'ilmoqda" Foreground="#B45309" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PickingList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Column}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,12">
                            <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ReadyHeader" Style="{StaticResource ColumnTitle}" Text="Tayyor" Foreground="#1D4ED8" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ReadyList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Column}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,12">
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="WayHeader" Style="{StaticResource ColumnTitle}" Text="Yo'lda" Foreground="#047857" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WayList" ItemTemplate="{StaticResource OrderCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tanlangan buyurtma / yig'ish paneli -->
            <Border Grid.Column="1" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Direction="270" />
                </Border.Effect>
                <Grid>
                    <StackPanel x:Name="EmptyDetail" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="Buyurtmani tanlang" Foreground="#64748B" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="🖨  Yig'ish varag'i" Style="{StaticResource ActionBtn}" Margin="0"
                                        Height="38" VerticalAlignment="Top" Click="PrintSheet_Click" />
                                <StackPanel>
                                    <Border Background="#FFF7ED" CornerRadius="8" Padding="10,3" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DetailStatus" FontSize="12" FontWeight="Bold" Foreground="#C2410C" />
                                    </Border>
                                    <TextBlock x:Name="DetailTitle" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="DetailCustomer" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailAddress" FontSize="13" Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailComment" FontSize="13" Foreground="#C2410C" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailCourier" FontSize="13" FontWeight="SemiBold" Foreground="#047857" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DetailPolicyBadge" CornerRadius="8" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="DetailPolicy" FontSize="13" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="DetailRatingBox" Background="#FFFBEB" CornerRadius="10" Padding="12,8" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DetailRating" FontSize="13" Foreground="#92400E" TextWrapping="Wrap" />
                            </Border>

                            <Border x:Name="ScanBox" BorderBrush="#10B981" BorderThickness="2" CornerRadius="12" Background="#F0FDF4"
                                    Margin="0,12,0,0" Padding="12,0" Height="46">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="▮▯▮" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="ScanInput" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             FontSize="14" KeyDown="ScanInput_KeyDown" ToolTip="Shtrix-kodni skanerlang — qator belgilanadi" />
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,12,0,6">
                                <TextBlock x:Name="PickedText" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                <TextBlock Text="Yig'ildi" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                            </DockPanel>
                            <ProgressBar x:Name="PickedProgress" Height="8" Foreground="#10B981" Background="#E2E8F0" BorderThickness="0">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="PART_Track" />
                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                                                        HorizontalAlignment="Left" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>

                        <!-- Amallar -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="DetailDiscounts" FontSize="12" Foreground="#C2410C" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="DetailTotal" DockPanel.Dock="Right" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock x:Name="DetailPayment" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel x:Name="ActionsPanel" />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="ItemsList" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource ItemRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" IsEnabled="{Binding CanCheck}">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Item.QuantityText}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            </Border>
                                            <Button Content="Markirovka kodi" Tag="{Binding}" Click="ItemMarking_Click" Style="{StaticResource MiniBtn}"
                                                    Visibility="{Binding MarkingEditVisibility}" />
                                            <Button Content="Miqdor" Tag="{Binding}" Click="ItemQty_Click" Style="{StaticResource MiniBtn}"
                                                    Visibility="{Binding EditVisibility}" />
                                            <Button Content="Almashtirish" Tag="{Binding}" Click="ItemReplace_Click" Style="{StaticResource MiniBtn}"
                                                    Visibility="{Binding EditVisibility}" />
                                            <Button Content="Yo'q" Tag="{Binding}" Click="ItemRemove_Click" Style="{StaticResource MiniDangerBtn}"
                                                    Visibility="{Binding EditVisibility}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.ProductName}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"
                                                       TextDecorations="{Binding Strike}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Item.CodeText}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding Item.MarkingText}" Visibility="{Binding Item.MarkingVisibility}"
                                                       Foreground="{Binding Item.MarkingBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
