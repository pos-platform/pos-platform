<Window x:Class="PosCloud.Desktop.Views.TransferQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O'tkazma to'lovi" Height="770" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F5F7">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summa -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="TO'LOV SUMMASI" FontSize="11" FontWeight="Bold"
                           Foreground="#94A3B8" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="AmountText" Text="0" FontSize="38" FontWeight="Black"
                               Foreground="#0F172A" />
                    <TextBlock Text="so'm" FontSize="17" FontWeight="Bold" Foreground="#94A3B8"
                               VerticalAlignment="Bottom" Margin="7,0,0,6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Karta -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="💳 Kartaga o'tkazma" FontSize="18" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Plastik karta ko'rinishi (NBU Platinum uslubida) -->
                <Border Width="540" Height="336" CornerRadius="24" HorizontalAlignment="Center"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0E1726" Offset="0" />
                            <GradientStop Color="#172337" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#1E293B" BlurRadius="30" ShadowDepth="8" Opacity="0.5" />
                    </Border.Effect>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Yuqori qator: bank brend + karta turi -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="BankShortBox" Background="#E67E22" CornerRadius="5"
                                        Padding="8,5" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="BankShortText" Foreground="White" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="18" />
                                </Border>
                                <TextBlock x:Name="BankNameText" Foreground="White" FontFamily="Segoe UI"
                                           FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Margin="13,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CardTypeText" Foreground="#D1D5DB" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- O'rta: chip + kontaktsiz + raqam -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Chip -->
                                <Border Width="60" Height="46" CornerRadius="8" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F6DC95" Offset="0" />
                                            <GradientStop Color="#C99B4E" Offset="0.5" />
                                            <GradientStop Color="#E8C877" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border BorderBrush="#A67C36" BorderThickness="0,1.3,0,1.3"
                                                VerticalAlignment="Center" Height="16" Margin="8,0" />
                                        <Border BorderBrush="#A67C36" BorderThickness="1.3,0,1.3,0"
                                                HorizontalAlignment="Center" Width="18" Margin="0,5" />
                                    </Grid>
                                </Border>
                                <!-- Kontaktsiz belgi -->
                                <Path Data="M0,0 A8,8 0 0 1 0,16 M5,-3 A12,12 0 0 1 5,21 M10,-5 A16,16 0 0 1 10,26"
                                      Stroke="#D1D5DB" StrokeThickness="2.1" VerticalAlignment="Center"
                                      Margin="18,0,0,0" Opacity="0.9" />
                            </StackPanel>

                            <!-- Karta raqami — Farrington 7B (haqiqiy karta/OCR shrifti), bo'rtma (embossed) effekt -->
                            <Grid Margin="0,20,0,0" HorizontalAlignment="Left">
                                <!-- Soya (pastki-o'ng) -->
                                <TextBlock Text="{Binding Text, ElementName=CardNumberText}"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="38"
                                           Foreground="#04101C" Margin="3,3,0,0" />
                                <!-- Yorug'lik qirrasi (yuqori-chap) -->
                                <TextBlock Text="{Binding Text, ElementName=CardNumberText}"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="38"
                                           Foreground="#8FB6DD" Opacity="0.75" Margin="-1.4,-1.4,0,0" />
                                <!-- Asosiy yuz -->
                                <TextBlock x:Name="CardNumberText" Text="0000 0000 0000 0000"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B" FontSize="38"
                                           Foreground="#EEF4FB" />
                            </Grid>
                        </StackPanel>

                        <!-- Pastki qator: muddat + egasi + Mastercard -->
                        <Grid Grid.Row="2">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <!-- Amal qilish muddati -->
                                <StackPanel x:Name="ExpiryPanel" Orientation="Horizontal"
                                            Margin="0,0,0,13" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="VALID" Foreground="#9CA3AF" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="THRU" Foreground="#9CA3AF" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock x:Name="ExpiryText" Foreground="#EEF4FB" FontSize="21"
                                               FontFamily="pack://application:,,,/Fonts/#Farrington7B"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#04101C" BlurRadius="1" ShadowDepth="1.4" Direction="315" Opacity="0.85" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                                <!-- Karta egasi -->
                                <TextBlock x:Name="HolderText" Text="" Foreground="#EEF4FB" FontSize="21"
                                           FontFamily="pack://application:,,,/Fonts/#Farrington7B"
                                           HorizontalAlignment="Left">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#04101C" BlurRadius="1" ShadowDepth="1.4" Direction="315" Opacity="0.85" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Mastercard belgisi -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse Width="40" Height="40" Fill="#EB001B" />
                                <Ellipse Width="40" Height="40" Fill="#F79E1B" Opacity="0.9" Margin="-16,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="HintText" FontSize="14" Foreground="#64748B"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- Tugmalar -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="✓  Pul tushdi — chekni chiqarish" Height="54"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="17"
                    BorderThickness="0" Cursor="Hand" Click="Confirm_Click" />
            <Button Content="Bekor qilish" Height="38" Margin="0,8,0,0"
                    Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0"
                    BorderThickness="1" Cursor="Hand" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
