{
  "Agent": {
    "BackendBaseUrl": "http://localhost:5000",
    "//ApiKey": "Backend appsettings.json dagi Agent:ApiKey bilan bir xil bo'lishi shart.",
    "ApiKey": "CHANGE_ME_local_agent_api_key",
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "FiscalModuleId": "SIM-FISCAL-0001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
