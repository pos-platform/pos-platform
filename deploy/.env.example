# PosCloud — docker-compose sirlari namunasi.
# Nusxa oling:  cp .env.example .env   va haqiqiy qiymatlarni qo'ying.
# .env ni GIT'ga qo'ymang (deploy/.gitignore buni bloklaydi).

# PostgreSQL (konteyner ichidagi DB uchun)
POSTGRES_USER=posplatform_app
POSTGRES_PASSWORD=CHANGE_ME_kuchli_parol

# JWT imzo kaliti — kamida 32 belgi, tasodifiy. Yaratish: openssl rand -base64 48
JWT_KEY=CHANGE_ME_kamida_32_belgilik_tasodifiy_kalit

# Boshlang'ich admin/superadmin parollari (birinchi kirgandan keyin almashtiring)
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_SUPERADMIN_PASSWORD=CHANGE_ME

# Lokal fiskal/printer agenti uchun API-kalit
AGENT_API_KEY=CHANGE_ME_tasodifiy_kalit

# To'lov shlyuzlari (ixtiyoriy)
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
